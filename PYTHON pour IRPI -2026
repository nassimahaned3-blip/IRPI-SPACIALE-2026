python# ==============================================================================
# PROGICIEL EXPERT : GeoIRPI v6.0 (ÉVALUATION ET INSTRUCTION DES DEMANDES)
# Moteur de Triage Géométrique Linéaire à Multi-Verrous Réglementaires
# ==============================================================================

def instruire_dossier_geoirpi_v6(nom_projet, masse_kg, enthalpie_mj_kg, pi_cinetique, dist_gaz, dist_oued, dist_ecole):
    """
    Exécute le screening préliminaire unitaire d'un projet d'investissement.
    Applique la linéarisation de l'indice et la matrice des 3 lois algériennes.
    """
    print("------------------------------------------------------------------")
    print(f"🔬 EXPERTISE TECHNIQUE ENVIRO-LÉGALE : [{nom_projet}]")
    print("------------------------------------------------------------------")
    
    # ==========================================================================
    # PHASE 1 : CALCUL DU POTENTIEL ÉNERGÉTIQUE SOURCE LINÉAIRE
    # Normalisation par la constante E0 = 1 000 000 MJ (1 Terajoule)
    # ==========================================================================
    energie_brute_mj = masse_kg * enthalpie_mj_kg
    constante_e0 = 1000000.0  # 1 TJ
    phi_linear = energie_brute_mj / constante_e0
    
    # ==========================================================================
    # PHASE 2 : CALCUL DE VULNÉRABILITÉ ET DE L'INDICE IRPI COMPOSITE
    # Utilisation d'une structure mixte (somme pondérée) pour éviter l'effet de masque
    # ==========================================================================
    # Détermination du facteur d'environnement local (Périphérie ou tissu urbain)
    if dist_gaz >= 500.0 and dist_ecole >= 200.0:
        omega_environnement = 1.0  # Zone stérile sécurisée
        statut_environnement = "Zone périphérique isolée"
    else:
        omega_environnement = 3.5  # Zone à forte vulnérabilité anthropique
        statut_environnement = "Tissu urbain ou couloir sensible"
        
    # Formule composite pondérée : l'effondrement de Pi n'annule plus la gravité de la masse
    coefficient_pi = 0.4
    coefficient_omega = 0.6
    score_irpi_mixte = phi_linear * (coefficient_pi * pi_cinetique + coefficient_omega * omega_environnement)
    
    # ==========================================================================
    # PHASE 3 : APPLICATION DE LA MATRICE DE VERROUS ABSOLUS (Iverson)
    # Les trois conditions doivent être respectées (1) pour valider l'arrêté
    # ==========================================================================
    # 1. Verrou Ouvrage Énergétique (Décret présidentiel n° 07-144)
    verrou_sonelgaz = 1 if dist_gaz >= 150.0 else 0
    
    # 2. Verrou de Protection des Ressources en Eau (Loi n° 05-12)
    verrou_hydrique = 1 if dist_oued >= 50.0 else 0
    
    # 3. Verrou de Sanctuarisation des Écoles et ERP (Loi n° 04-20)
    verrou_scolaire = 1 if dist_ecole >= 100.0 else 0
    
    # Produit logique d'Iverson (Toute valeur à 0 entraîne l'effondrement du verdict)
    verdict_final = verrou_sonelgaz * verrou_hydrique * verrou_scolaire
    
    # ==========================================================================
    # PHASE 4 : AFFICHAGE DES RÉSULTATS ET ORIENTATION DE L'ARRÊTÉ
    # ==========================================================================
    print(f"   ├── 📊 Masse Confinée Déclarée     : {masse_kg:,} kg")
    print(f"   ├── 📊 Gravité Source Linéaire     : {phi_linear:.4f} Terajoules (TJ)")
    print(f"   ├── 🗺️ Morphologie Territoriale    : {statut_environnement} (Omega = {omega_environnement})")
    print(f"   ├── 👑 Score IRPI Mixte Spatial    : {score_irpi_mixte:.6f}")
    print(f"   ├── ⚡ Filtre 1 : Servitude Sonelgaz: {'🟢 CONFORME' if verrou_sonelgaz == 1 else '❌ INFRACTION'} ({dist_gaz}m / Seuil 150m)")
    print(f"   ├── 💧 Filtre 2 : Domaine Hydrique : {'🟢 CONFORME' if verrou_hydrique == 1 else '❌ INFRACTION'} ({dist_oued}m / Seuil 50m)")
    print(f"   ├── 🏫 Filtre 3 : Enveloppe Scolaire: {'🟢 CONFORME' if verrou_scolaire == 1 else '❌ INFRACTION'} ({dist_ecole}m / Seuil 100m)")
    print("   ------------------------------------------------------------------")
    
    if verdict_final == 1:
        print("   🟢 SÉCURITÉ ADMINISTRATIVE : INTERSECTION FINALE CONFORME")
        print("      👉 Décision : Quitus accordé. Transmission du dossier pour arrêté d'autorisation.")
        return "DOSSIER_HOMOLOGUE"
    else:
        print("   ❌ SÉCURITÉ ADMINISTRATIVE : VETO AUTOMATIQUE ACTIVÉ")
        print("      👉 Décision : Rejet immédiat du permis d'installer (Infraction réglementaire).")
        return "DOSSIER_REFUSE"


